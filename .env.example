# Copy this file to .env before first start:
#   cp .env.example .env
#
# Generate a stronger value before production use:
#   openssl rand -base64 36
#
# Important: after the PostgreSQL volume is initialized, changing this value
# here does not change the existing database user's password.
LIBREPLAN_DBPASSWORD=change-this-before-first-start

# Keep 127.0.0.1 when LibrePlan sits behind a host-level reverse proxy.
# Use 0.0.0.0 only if you intentionally want direct LAN/public access.
LIBREPLAN_BIND=127.0.0.1
LIBREPLAN_PORT=8080

TZ=America/Argentina/Buenos_Aires